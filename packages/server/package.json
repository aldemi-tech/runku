{
  "name": "@runku/server",
  "version": "0.4.2",
  "description": "Declarative Function, schema and Cron SDK for Runku",
  "type": "module",
  "license": "Apache-2.0",
  "homepage": "https://github.com/aldemi-tech/runku/tree/main/packages/server#readme",
  "bugs": {
    "url": "https://github.com/aldemi-tech/runku/issues"
  },
  "keywords": ["runku", "server", "typescript", "functions", "schema"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aldemi-tech/runku.git",
    "directory": "packages/server"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.check.json",
    "lint": "tsc -p tsconfig.check.json",
    "check": "pnpm typecheck && pnpm lint && pnpm build"
  },
  "devDependencies": {
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=20"
  }
