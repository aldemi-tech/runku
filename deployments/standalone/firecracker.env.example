# Controller contract for one immutable Firecracker pool. Never put the IPC token here.
RUNKU_FIRECRACKER_ASSET_DIR=/var/lib/runku/assets/sha256-REPLACE_ME
RUNKU_FIRECRACKER_STATE_ROOT=/var/lib/runku/firecracker
RUNKU_FIRECRACKER_TOKEN_FILE=/run/secrets/runku-firecracker-token
RUNKU_FIRECRACKER_IMAGE_REFERENCE=registry.example/runku/function@sha256:REPLACE_WITH_64_HEX

RUNKU_FIRECRACKER_WORKERS=4
RUNKU_FIRECRACKER_MEMORY_MIB=256
RUNKU_FIRECRACKER_VCPU_COUNT=1
RUNKU_FIRECRACKER_NETWORK_OCTET_BASE=220
RUNKU_FIRECRACKER_RUNNER_PORT=32110
RUNKU_FIRECRACKER_UID=65532
RUNKU_FIRECRACKER_GID=65532

# none | public | restricted. Allow/deny encoding is destination|port[,port];...
RUNKU_FIRECRACKER_EGRESS_MODE=none
RUNKU_FIRECRACKER_EGRESS_ALLOW=
RUNKU_FIRECRACKER_EGRESS_DENY=
RUNKU_FIRECRACKER_DNS_SERVERS=1.1.1.1,1.0.0.1
