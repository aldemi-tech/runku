COMPOSE_PROJECT_NAME=runku
RUNKU_DEPLOYMENT_PROFILE=standalone
# Replace the digest with the manifest digest published by the selected GitHub release.
RUNKU_SERVER_IMAGE=ghcr.io/aldemi-tech/runku-server:0.3.0@sha256:REPLACE_WITH_64_HEX_CHARACTERS
RUNKU_DATA_DIRECTORY=/srv/runku
RUNKU_SECRETS_DIRECTORY=/etc/runku/secrets
RUNKU_UID=65532
RUNKU_GID=65532
RUNKU_POSTGRES_PORT=55432
RUNKU_PUBLIC_MANAGEMENT_URL=https://management.example.com
RUNKU_MEMORY_LIMIT=2g
RUNKU_CPU_LIMIT=2.0
RUNKU_PIDS_LIMIT=512

# Set these only when compose.browser.yaml is selected.
RUNKU_PRODUCT_ALLOWED_ORIGINS=https://app.example.com
RUNKU_PRODUCT_AUTH_CONFIG=config/application-oidc.json

# Set these only when compose.ha-logs.yaml is selected.
RUNKU_LOG_ARCHIVE_S3_BUCKET=runku-operational-logs
RUNKU_LOG_ARCHIVE_S3_REGION=us-east-1
RUNKU_LOG_ARCHIVE_S3_PREFIX=installation-01
RUNKU_LOG_ARCHIVE_S3_ENDPOINT=
RUNKU_LOG_ARCHIVE_S3_VIRTUAL_HOSTED_STYLE=true
RUNKU_LOG_ARCHIVE_AWS_PROFILE=default
RUNKU_LOG_JOURNAL_URL=tls://nats.example.internal:4222
RUNKU_LOG_JOURNAL_REPLICAS=3
RUNKU_LOG_ARCHIVE_BATCH_WAIT_SECONDS=30
RUNKU_LOG_WORKER_REPLICAS=2
