BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://127.0.0.1:3000
BETTER_AUTH_DATABASE_PATH=.data/auth.sqlite3
NEXT_PUBLIC_RUNKU_URL=http://127.0.0.1:3210
NEXT_PUBLIC_RUNKU_TARGET=workspace:local
# Local: pnpm dev provisions both automatically into ignored .env.local.
# Remote: create these in the target Environment and provide them explicitly.
NEXT_PUBLIC_RUNKU_KEY=
RUNKU_SECRET_KEY=
# Optional server-only overrides when the BFF uses a private Runku endpoint/target.
# RUNKU_URL=https://runku.internal.example
# RUNKU_TARGET=workspace:team/debug
